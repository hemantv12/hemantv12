PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=./collabzy.db
# Optional: when set, use the managed PostgreSQL backend instead of SQLite.
# Keep this secret; use Render's Internal Database URL for the dedicated Collabzy database.
DATABASE_URL=
# Set to disable SSL only for local/test PostgreSQL; leave unset on Render.
PGSSLMODE=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-api-domain.example/api/instagram/callback

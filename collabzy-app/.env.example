PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=./collabzy.db
# Optional: when set, use the managed PostgreSQL backend instead of SQLite.
# Keep this secret; use Render's Internal Database URL for the dedicated Collabzy database.
DATABASE_URL=
# Set to disable SSL only for local/test PostgreSQL; leave unset on Render.
PGSSLMODE=
# Explicit opt-in for a one-time migration from this app's existing SQLite file.
# Back up first; enable only when target PostgreSQL is empty and source DB is verified.
MIGRATE_SQLITE_ON_START=false
SQLITE_MIGRATION_PATH=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://collabzy-api.onrender.com/api/instagram/callback
# Optional comment-triggered private replies. Keep false until Meta review and end-to-end tests pass.
META_AUTO_DM_ENABLED=false
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Invite-only private beta. Keep this in the hosting secret store; never commit a real value.
# Use a random secret of 24+ characters. This does not verify an email or activate a paid plan.
COLLABZY_PRIVATE_BETA_CODE=

# AI Growth Coach (used only after the user confirms AI data-use notice).
OPENAI_API_KEY=
OPENAI_ANALYTICS_MODEL=gpt-5-mini
OPENAI_STUDIO_MODEL=gpt-5-mini

# ₹299/year Collabzy Pro checkout; webhook URL: /api/billing/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email verification, password recovery and support delivery (Resend).
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
PUBLIC_APP_URL=https://collabzy-api.onrender.com

# Required production launch gates. Enable these before opening registration to the public.
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_INSTAGRAM_CONFIG=true
# Keep false until live email/Meta tests, legal review, backup restore and production hosting are approved.
PUBLIC_LAUNCH_APPROVED=false

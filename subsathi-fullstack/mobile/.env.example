# Android emulator: this default is usually reachable from Android Studio's emulator.
# Physical phone: set this to your computer's LAN IP while developing, or the deployed HTTPS API URL.
EXPO_PUBLIC_API_BASE_URL=https://subsathi-api.onrender.com
# For local Android emulator development, use http://10.0.2.2:8000
# Optional production AdMob banner unit ID. Leave blank to show Google test ads only.
# Test ads do not generate revenue. Set your own AdMob Android banner ID only after approval.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

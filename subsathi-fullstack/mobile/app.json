{
  "expo": {
    "name": "SubSathi",
    "slug": "subsathi",
    "version": "0.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "subsathi",
    "android": {
      "package": "in.subsathi.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0D2330",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#15A879",
          "defaultChannel": "renewals"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "androidSdk": "classic"
        }
      ]
    ],
    "extra": {
      "appStage": "polished-beta",
      "gmailIntegration": "requires-owner-oauth-credentials"
    },
    "icon": "./assets/icon.png"
  }
}

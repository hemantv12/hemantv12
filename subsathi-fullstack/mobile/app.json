{
  "expo": {
    "name": "SubSathi",
    "slug": "subsathi",
    "version": "0.5.11",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "subsathi",
    "android": {
      "package": "in.subsathi.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#0D2330",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#15A879",
          "defaultChannel": "renewals"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "androidSdk": "classic"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SubSathi to use the microphone when you ask a voice question.",
          "speechRecognitionPermission": "Allow SubSathi to convert your voice question into text."
        }
      ]
    ],
    "extra": {
      "appStage": "provider-aware-subscription-control",
      "gmailIntegration": "requires-owner-oauth-credentials"
    },
    "icon": "./assets/icon.png"
  }
}

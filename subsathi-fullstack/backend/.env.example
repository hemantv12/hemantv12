APP_ENV=development
# Production: use Render PostgreSQL's DATABASE_URL. Local development uses SQLite if omitted.
DATABASE_URL=sqlite:///./subsathi.db
API_BASE_URL=http://localhost:8000

# Configure a Google OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MOBILE_REDIRECT_URI=subsathi://auth

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# In production, generate a random secret at least 32 characters long.
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=subsathi-api
SESSION_DAYS=14
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SCAN_MAX_MESSAGES=200
GMAIL_SCAN_QUERY=newer_than:3y {receipt invoice subscription renewal membership payment "auto-renew" "trial ends"}
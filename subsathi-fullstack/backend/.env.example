APP_ENV=development
# Production: use Render PostgreSQL's DATABASE_URL. Local development uses SQLite if omitted.
DATABASE_URL=sqlite:///./subsathi.db
API_BASE_URL=http://localhost:8000

# Configure a Google OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MOBILE_REDIRECT_URI=subsathi://auth

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# In production, generate a random secret at least 32 characters long.
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=subsathi-api
SESSION_DAYS=14
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SCAN_MAX_MESSAGES=500
GMAIL_SCAN_QUERY=newer_than:5y {subject:receipt subject:invoice subject:subscription subject:renewal subject:renewed subject:membership subject:billing subject:purchase "auto-renew" "recurring payment" "billing cycle" "trial ends" "next payment" "your plan renews" "payment successful"}
# Optional AI extraction. Disabled unless the user opts in during scanning and this key is set.
# Configure privately on Render; never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local development defaults only. Never use these placeholders in production.
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./earnroute.db
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=
MARKET_TIMEZONE=Asia/Kolkata
TRAVEL_BUFFER_MINUTES=45
DEFAULT_PLATFORM_FEE_PERCENT=12

# Optional observability/provider integrations; leave blank until configured.
APP_RELEASE=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# Razorpay webhook signature support does not itself enable checkout or payouts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
